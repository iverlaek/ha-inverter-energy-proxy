[Unit]
Description=Token-protected lifecycle control API for the inverter proxy stack
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=verlaek
Group=verlaek
WorkingDirectory=/home/verlaek/ha-inverter-energy-proxy
ExecStart=/usr/bin/python3 /home/verlaek/ha-inverter-energy-proxy/scripts/proxy_control.py --listen-host 0.0.0.0 --port 8790 --token-file /home/verlaek/.secrets/proxy_control_token
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
