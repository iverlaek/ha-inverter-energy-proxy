# Copy to `.env` and adjust for your LAN.
#
# The proxy gives every facade its own IP address on a macvlan network, so each
# emulated device looks like a separate box on the LAN. Pick addresses that are
# free on your subnet.

# The wired interface the macvlan network hangs off. Wi-Fi generally does not
# support macvlan; use Ethernet.
LAN_PARENT=enp3s0
LAN_SUBNET=192.168.55.0/24
LAN_GATEWAY=192.168.55.1

# Addresses the containers will take. Keep them outside your DHCP pool.
CORE_IP=192.168.55.91
GOODWE_FACADE_IP=192.168.55.92
# Reserved for the brands that come later:
# SOLAREDGE_FACADE_IP=192.168.55.93
# ENPHASE_FACADE_IP=192.168.55.94

# Optional: an address this host takes on a macvlan "shim" so it can reach the
# containers (macvlan otherwise blocks host<->container traffic). Needed only
# when a consumer runs on the same machine as this stack.
SHIM_IP=192.168.55.87
